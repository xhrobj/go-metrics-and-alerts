# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Binaries
/cmd/agent/agent
/cmd/server/server

# Dependency directories (remove the comment below to include it)
# /vendor/

#runtime data
**/metrics-db.json
*.log

# IDEs directories
/.idea/
/.vscode/

#macOS
.DS_Store
__MACOSX/

# tmp files
/sandbox/
/tools/

# RSA-ключи для запуска Агента/Сервера
/.keys/

# JSON-конфиги Агента и Сервера (разрешены только два example-конфига)
/configs/*
!/configs/agent.example.json
!/configs/server.example.json
